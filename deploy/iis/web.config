<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy for the frontend server (เครื่อง 1).
  Put this file alone in the IIS site's physical folder (e.g. C:\inetpub\leave-management),
  bind the site to https:443 with the SSL certificate (+ http:80 for the redirect).
  Requires: IIS URL Rewrite 2.1 + Application Request Routing 3.0 (ARR),
  with the server-level setup commands in DEPLOYMENT.md already run.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Proxy to Next.js" stopProcessing="true">
          <match url=".*" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <!-- UNENCODED_URL keeps Thai/encoded file names intact; it already contains the query string -->
          <action type="Rewrite" url="http://127.0.0.1:3000{UNENCODED_URL}" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <!-- Backend accepts 50MB base64 uploads; IIS default is ~30MB. allowDoubleEscaping lets
           '+' and '%25' in file names through. -->
      <requestFiltering allowDoubleEscaping="true">
        <requestLimits maxAllowedContentLength="62914560" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
